    bool "ERROR"

config RIVER_LOG_LEVEL_WARN
    bool "WARN"

config RIVER_LOG_LEVEL_INFO
    bool "INFO"

config RIVER_LOG_LEVEL_DEBUG
    bool "DEBUG"

endchoice

