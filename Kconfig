menu "Ameba River"

config AMEBA_RIVER_EN
    bool "Enable ameba-river application"
    default y

config RIVER_ORVIBO_CLIENT_EN
    bool "Enable Orvibo realtime voice client"
    default y
    help
      Build the Orvibo voice-client mainline. The first external wire
      contract is compatible with the XiaoZhi websocket protocol, but the
      firmware architecture is Orvibo-owned.

config RIVER_ORVIBO_OTA_URL
    string "Orvibo access OTA/config URL"
    default "https://api.tenclass.net/xiaozhi/ota/"
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      XiaoZhi-compatible OTA endpoint used to fetch websocket url/token/version
      and activation instructions before opening the realtime audio channel.

config RIVER_ORVIBO_WS_URL
    string "Orvibo fallback websocket URL"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional static fallback websocket endpoint. Leave this empty to require
      OTA/config before the realtime channel is opened. If you explicitly set a
      websocket URL here, the client can use it directly; when the target
      server has auth enabled, pair it with RIVER_ORVIBO_WS_TOKEN.

config RIVER_ORVIBO_WS_TOKEN
    string "Orvibo fallback websocket token"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional static websocket token for auth-enabled deployments. Leave empty
      when the explicitly configured fallback websocket server accepts
      unauthenticated connections.

config RIVER_ORVIBO_WS_SUBPROTOCOL
    string "Orvibo websocket subprotocol"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional Sec-WebSocket-Protocol value for the realtime connection. Leave
      empty to match the XiaoZhi reference clients, which do not request a
      websocket subprotocol.

config RIVER_ORVIBO_PROTOCOL_VERSION
    int "Orvibo websocket binary protocol version"
    range 1 3
    default 1
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Default to protocol version 1 for direct XiaoZhi-compatible websocket
      interoperability. In this mode binary websocket frames carry raw Opus
      packets without the v2/v3 wrapper. OTA/config can still override this
      when the target deployment explicitly returns a newer websocket version.

config RIVER_ORVIBO_SERVER_WAKE_TEXT
    string "Orvibo server wake text"
    default "你好小智"
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Text sent in the XiaoZhi-compatible `listen detect` control message after
      the local wake-word path triggers. This is intentionally decoupled from
      the protected local KWS implementation so the branch can preserve the
      current on-device wake phrase while still matching the target server's
      expected wakeup-word semantics.

config RIVER_ORVIBO_DEVICE_ID
    string "Orvibo fixed Device-Id"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional stable Device-Id used for OTA/config and activation. Leave empty
      to derive the identity from the runtime STA MAC. On empty-efuse boards the
      runtime STA MAC can change between boots, so setting this to a stable
      MAC-format value keeps server binding from drifting across reboots.

config RIVER_ORVIBO_ACTIVATION_SERIAL_NUMBER
    string "Orvibo optional activation serial number"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional XiaoZhi-compatible v2 activation serial number. Leave empty to
      use the default v1/no-serial activation flow. When this and
      RIVER_ORVIBO_ACTIVATION_HMAC_KEY are both set, OTA and activation
      requests use Activation-Version 2 and send a Serial-Number header.

config RIVER_ORVIBO_ACTIVATION_HMAC_KEY
    string "Orvibo optional activation HMAC key"
    default ""
    depends on RIVER_ORVIBO_CLIENT_EN
    help
      Optional XiaoZhi-compatible v2 activation HMAC key. It is used as raw
      string bytes for HMAC-SHA256(challenge), matching py-xiaozhi's local
      efuse.json behavior. Leave empty to keep the default v1/no-serial
      activation payload.

config RIVER_DIAG_CMD_EN
    bool "Enable river monitor command"
    default y

config RIVER_AUDIO_ECHO_DEBUG_EN
    bool "Build board audio echo debug path"
    default n
    help
      Build the standalone board audio echo loopback path and related
      monitor commands. Keep disabled for the normal wake -> Orvibo
      product flow to avoid carrying extra debug-only code and strings
      in the firmware image.

