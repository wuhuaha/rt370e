menu "Ameba River"

config AMEBA_RIVER_EN
    bool "Enable ameba-river application"
    default y

config RIVER_ONLINE_CONTROL_EN
    bool "Enable online home control path"
    default y

config RIVER_DIAG_CMD_EN
    bool "Enable river monitor command"
    default y

config RIVER_AUDIO_ECHO_AUTOSTART
    bool "Autostart board audio echo at boot"
    default n

config RIVER_AUDIO_ECHO_DIAG_DEFAULT_ON
    bool "Enable audio echo diagnostics by default"
    default n

config RIVER_SPEAKER_TEST_AUTOSTART
    bool "Autostart direct speaker playback test at boot"
    default n

config RIVER_SPEAKER_TEST_DIAG_DEFAULT_ON
    bool "Enable speaker playback diagnostics by default"
    default n

choice RIVER_LOCAL_FRONTEND_MODE
    prompt "Local voice front-end mode"
    default RIVER_LOCAL_VAD_ONLY

config RIVER_LOCAL_VAD_ONLY
    bool "Local VAD only"

config RIVER_LOCAL_VAD_WAKEWORD
    bool "Local VAD + wake word"

endchoice

config RIVER_OFFLINE_ASR_RESERVED
    bool "Reserve offline ASR integration points"
    default y

endmenu
