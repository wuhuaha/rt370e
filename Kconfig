    range 0 1000
    default 320
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_PRE_ROLL_FLUSH_MAX_FRAMES
    int "Wake-word KWS maximum pre-roll frames flushed into the worker"
