    int "Wake-word KWS tensor arena size in KB"
    range 32 16384
    default 160
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_SCORE_THRESHOLD_Q15
    int "Wake-word KWS trigger threshold in q15"
    range 1 32767
    default 27852
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_TRIGGER_HOLD_FRAMES
    int "Wake-word KWS consecutive trigger frames"
    range 1 8
    default 2
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_COOLDOWN_MS
    int "Wake-word KWS cooldown in milliseconds"
    range 0 10000
    default 1800
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_GATE_FALLBACK_EN
    bool "Wake-word KWS VAD gate fallback trigger"
    default y
    depends on RIVER_VOICE_CAPABILITY_KWS
    help
      Allow the VAD gate close path to emit a wake-word trigger from the
      best score observed inside the speech gate when no consecutive main
      threshold trigger was latched. Disable this for conservative
      false-trigger triage so wake emission requires consecutive
      RIVER_KWS_SCORE_THRESHOLD_Q15 hits.

