    int "WebRTC AECM reference active exit peak"
    range 1 32767
    default 64
    depends on RIVER_WEBRTC_AECM_EXPERIMENT_EN

config RIVER_WEBRTC_AECM_REF_STABLE_FRAMES
    int "WebRTC AECM reference enter stable frames"
    range 1 32
    default 3
    depends on RIVER_WEBRTC_AECM_EXPERIMENT_EN

config RIVER_WEBRTC_AECM_REF_HANGOVER_FRAMES
    int "WebRTC AECM reference exit hangover frames"
    range 1 64
    default 8
    depends on RIVER_WEBRTC_AECM_EXPERIMENT_EN

