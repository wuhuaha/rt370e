menu "Ameba River"

config AMEBA_RIVER_EN
    bool "Enable ameba-river application"
    default y

config RIVER_ONLINE_CONTROL_EN
    bool "Enable online home control path"
    default y

config RIVER_DIAG_CMD_EN
    bool "Enable river monitor command"
    default y

choice RIVER_LOG_DEFAULT_LEVEL
    prompt "Default river log level"
    default RIVER_LOG_LEVEL_INFO

config RIVER_LOG_LEVEL_ERROR
    bool "ERROR"

config RIVER_LOG_LEVEL_WARN
    bool "WARN"

config RIVER_LOG_LEVEL_INFO
    bool "INFO"

config RIVER_LOG_LEVEL_DEBUG
    bool "DEBUG"

endchoice

config RIVER_AUDIO_ECHO_AUTOSTART
    bool "Autostart board audio echo at boot"
    default n

config RIVER_AUDIO_ECHO_DIAG_DEFAULT_ON
    bool "Enable audio echo diagnostics by default"
    default n

config RIVER_VAD_PROBE_AUTOSTART
    bool "Autostart pure VAD probe at boot"
    default n

config RIVER_VAD_PROBE_DIAG_DEFAULT_ON
    bool "Enable VAD probe diagnostics by default"
    default n

choice RIVER_VOICE_PREPROC_BACKEND
    prompt "Local voice pre-processing backend"
    default RIVER_VOICE_PREPROC_FIXED_DSB

config RIVER_VOICE_PREPROC_FIXED_DSB
    bool "Fixed delay-and-sum beamformer"

endchoice

config RIVER_VOICE_DSB_SECONDARY_DELAY_SAMPLES
    int "Fixed DSB secondary-mic delay in samples"
    range 0 8
    default 0

choice RIVER_VOICE_PREPROC_PROFILE
    prompt "Local voice pre-processing profile"
    default RIVER_VOICE_PREPROC_PROFILE_ASR_MAINLINE

config RIVER_VOICE_PREPROC_PROFILE_ASR_MAINLINE
    bool "ASR mainline"

endchoice

choice RIVER_VOICE_DETECTOR_BACKEND
    prompt "Local voice detector backend"
    default RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_VOICE_DETECTOR_SILERO_VAD
    bool "Silero VAD"

endchoice

config RIVER_SILERO_VAD_TENSOR_ARENA_KB
    int "Silero VAD tensor arena size in KB"
    range 64 1024
    default 256
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_SILERO_VAD_SPEECH_THRESHOLD_Q15
    int "Silero VAD speech enter threshold in q15"
    range 1 32767
    default 9000
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_SILERO_VAD_SILENCE_THRESHOLD_Q15
    int "Silero VAD speech exit threshold in q15"
    range 1 32767
    default 2500
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_SILERO_VAD_HANGOVER_FRAMES
    int "Silero VAD hangover decisions"
    range 0 64
    default 10
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_SILERO_VAD_EMA_SHIFT
    int "Silero VAD probability EMA shift"
    range 0 6
    default 1
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_VAD_PROBE_DIAG_WINDOW_MS
    int "Pure VAD probe diagnostic window in milliseconds"
    range 16 1000
    default 96

config RIVER_VAD_PROBE_PRE_ROLL_MS
    int "Pure VAD probe segment pre-roll in milliseconds"
    range 0 2000
    default 384

config RIVER_VAD_PROBE_POST_ROLL_MS
    int "Pure VAD probe segment post-roll in milliseconds"
    range 0 4000
    default 768

config RIVER_VAD_PROBE_MAX_SEGMENT_MS
    int "Pure VAD probe max buffered segment length in milliseconds"
    range 500 30000
    default 8000

config RIVER_VAD_PROBE_SEGMENT_MIN_FREE_HEAP_KB
    int "Pure VAD probe batch segment minimum free heap headroom in KB"
    range 0 2048
    default 64

config RIVER_OFFLINE_ASR_RESERVED
    bool "Reserve offline ASR integration points"
    default y

endmenu
