config RIVER_VOICE_CAPABILITY_KWS
    bool "Enable local wake-word sidepath"
    default y
    help
      Enables the wake-stage local KWS sidepath on top of the current
      fixed_dsb mono stream. When enabled, the active voice profile exposes
      the KWS capability and the board runs a local DS-CNN wake-word model.

choice RIVER_KWS_MODEL_VARIANT
    prompt "Wake-word KWS embedded model variant"
    default RIVER_KWS_MODEL_VARIANT_BASELINE
    depends on RIVER_VOICE_CAPABILITY_KWS

config RIVER_KWS_MODEL_VARIANT_BASELINE
    bool "Current baseline embedded model"
    help
      Keep the repository baseline embedded DS-CNN wake-word model.

config RIVER_KWS_MODEL_VARIANT_FP32_EXPERIMENTAL
    bool "BC-ResNet V3 FP32 experimental model"
    help
      Use the larger float32 BC-ResNet V3 model exported from
      /root/kws-training-pro/models/bc_resnet_iteration3/bc_resnet_v3_fp32.tflite.
      This profile is intended for on-board arena/CPU bring-up and should
      be validated with board-recording-derived thresholds before promotion.

config RIVER_KWS_MODEL_VARIANT_ROUND6_TARGETED_EXPERIMENTAL
    bool "Round6 targeted student experimental model"
    help
      Use the round6 targeted DS-CNN student exported from
      /root/river-openwakeword-lab. This is an engineering smoke-test
      variant for the DS-CNN branch and is not yet a deploy-ready model.

config RIVER_KWS_MODEL_VARIANT_STUDENT_BC_RESNET_NANO_V2_FP32_DEBUG
    bool "Student BC-ResNet nano v2 FP32 debug model"
    help
      Use the parallel FP32 debug bundle exported from
      /root/kws-trainint/artifacts/exports/student_bc_resnet_nano_v2.
      This variant is reserved for board/local parity work on the
      `40x101`, `n_fft=400`, centered log-mel frontend so the lighter
      BC-ResNet nano branch can be deployment-checked without replacing the
      current mainline chain.

config RIVER_KWS_MODEL_VARIANT_STUDENT_DSCNN_TINY_V2_FP32_DEBUG
    bool "Student DS-CNN tiny v2 FP32 debug model"
    help
      Use the parallel FP32 debug bundle exported from
      /root/kws-trainint/artifacts/exports/student_dscnn_tiny_v2.
      This variant is reserved for board/local parity work on the
      `40x101`, `n_fft=400`, centered log-mel frontend so the smallest
      current student bring-up model can be board-profiled without
      disturbing the mainline chain.

config RIVER_KWS_MODEL_VARIANT_STUDENT_DSCNN_TINY_V2_INT8_DEBUG
    bool "Student DS-CNN tiny v2 INT8 debug model"
    help
      Use the parallel INT8 deployment bundle exported from
      /root/kws-trainint/artifacts/exports/student_dscnn_tiny_v2.
      This variant is reserved for board/local parity work and board-side
      realtime probing on the `40x101`, `n_fft=400`, centered log-mel
