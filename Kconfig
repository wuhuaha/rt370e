menu "Ameba River"

config AMEBA_RIVER_EN
    bool "Enable ameba-river application"
    default y

config RIVER_ONLINE_CONTROL_EN
    bool "Enable online home control path"
    default y

config RIVER_DIAG_CMD_EN
    bool "Enable river monitor command"
    default y

config RIVER_AUDIO_ECHO_AUTOSTART
    bool "Autostart board audio echo at boot"
    default n

config RIVER_AUDIO_ECHO_DIAG_DEFAULT_ON
    bool "Enable audio echo diagnostics by default"
    default n

config RIVER_BOARD_RGB_VAD_INDICATOR_EN
    bool "Enable RGB VAD status indicator"
    default y

choice RIVER_VOICE_PREPROC_BACKEND
    prompt "Local voice pre-processing backend"
    default RIVER_VOICE_PREPROC_AIVOICE_AFE

config RIVER_VOICE_PREPROC_AIVOICE_AFE
    bool "AIVoice AFE"

endchoice

choice RIVER_VOICE_PREPROC_PROFILE
    prompt "Local voice pre-processing profile"
    default RIVER_VOICE_PREPROC_PROFILE_ASR_BARGE_IN_AEC

config RIVER_VOICE_PREPROC_PROFILE_ASR_MAINLINE
    bool "ASR mainline"

config RIVER_VOICE_PREPROC_PROFILE_ASR_BARGE_IN_AEC
    bool "ASR + AEC barge-in"

endchoice

choice RIVER_VOICE_DETECTOR_BACKEND
    prompt "Local voice detector backend"
    default RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_VOICE_DETECTOR_SILERO_VAD
    bool "Silero VAD"

endchoice

config RIVER_SILERO_VAD_TENSOR_ARENA_KB
    int "Silero VAD tensor arena size in KB"
    range 64 1024
    default 256
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_SILERO_VAD_SPEECH_THRESHOLD_Q15
    int "Silero VAD speech threshold in q15"
    range 1 32767
    default 16384
    depends on RIVER_VOICE_DETECTOR_SILERO_VAD

config RIVER_OFFLINE_ASR_RESERVED
    bool "Reserve offline ASR integration points"
    default y

endmenu
